{
  "name": "instagram-saves",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:contracts": "vitest run src/lib/storage/contracts.test.ts",
    "test:pg": "vitest run src/lib/storage/contracts.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:parse": "pnpm exec tsx scripts/test-parse.ts",
    "test:all": "pnpm test:unit && pnpm test:parse",
    "db:generate": "pnpm db:generate:sqlite && pnpm db:generate:postgres",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "bench:smoke": "pnpm exec tsx scripts/bench-smoke.ts",
    "bench:scale": "pnpm exec tsx scripts/bench-scale.ts",
    "soak:scale": "pnpm exec tsx scripts/soak-scale.ts",
    "reindex": "pnpm exec tsx scripts/reindex-search.ts",
    "embedding-worker": "node --max-old-space-size=2048 ./node_modules/tsx/dist/cli.mjs scripts/embedding-worker.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@next/env": "^16.2.12",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sqlite-vec": "^0.1.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.13.1"
}
