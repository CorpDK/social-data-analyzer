# Preferred default semantic provider when no UI/URL override is set:
# local | openai | voyage
# OpenAI and Voyage can run simultaneously when both API keys are set.
# If omitted: OPENAI_API_KEY -> openai, else VOYAGE_API_KEY -> voyage, else local.
# EMBEDDING_PROVIDER=openai

# OpenAI or an OpenAI-compatible /v1/embeddings endpoint.
# OPENAI_API_KEY=your_openai_api_key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# Voyage AI (native API shape, not OpenAI-compatible).
# VOYAGE_API_KEY=your_voyage_api_key
# VOYAGE_MODEL=voyage-4-lite

# Local, OpenAI, and Voyage embeddings are fixed at 1024 dimensions.
# Changing remote model or endpoint requires reindexing that provider.

# Remote request timeout in milliseconds. Offline fallback is automatic.
# EMBEDDING_TIMEOUT_MS=10000

# On the Saves page, switch semantic search via the UI (or ?provider=openai).
# The choice is stored in localStorage and synced to the URL when possible.
