# Optional overrides for CI / headless automation.
# Prefer Settings in the app UI for normal use (keys → system keyring;
# enable flags, models, URLs, timeout, preferred provider → SQLite app_settings).

# Infra / test only (not exposed in Settings):
# INSTAGRAM_SAVES_DB=/path/to/instagram-saves.db
# INSTAGRAM_SAVES_KEYRING=memory

# Optional runtime fallbacks (used only when Settings has no value):
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4-lite
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# OLLAMA_API_KEY=ollama
# EMBEDDING_TIMEOUT_MS=10000

# Explicit index enables (CI only when sqlite flag unset). Credentials alone never enable.
# LOCAL_ENABLED=1
# OPENAI_ENABLED=1
# VOYAGE_ENABLED=1
# OLLAMA_ENABLED=1
# EMBEDDING_OLLAMA=1
